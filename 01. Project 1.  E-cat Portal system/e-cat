                    view_results()

                elif choice == "5":

                    break

                else:

                    print("Invalid Choice")

            return

        else:

            attempts += 1
            print("Wrong Username Or Password")
            print("Attempts Left:", 3 - attempts)

    print("Admin Account Locked")


def student_portal():

    attempts = 0

    while attempts < 3:

        user = input("Enter Student Username: ")
        pas = input("Enter Student Password: ")

        if user == student_username and pas == student_password:

            print("Login Successful")
            break

        else:

            attempts += 1
            print("Wrong Username Or Password")
            print("Attempts Left:", 3 - attempts)

    if attempts == 3:

        print("Student Account Locked")
        return

    name = input("Enter Name: ")
    roll = input("Enter Roll No: ")

    score = 0

    correct = 0
    wrong = 0
    skip = 0

    answers = {}

    for i in range(len(questions)):

        q = questions[i]

        print("\nQuestion", i + 1)

        print(q["question"])

        print("A.", q["A"])
        print("B.", q["B"])
        print("C.", q["C"])
        print("D.", q["D"])

        ans = input("Enter A/B/C/D or S: ").upper()

        answers[i] = ans

        if ans == q["answer"]:

            score = score + 4
            correct = correct + 1

        elif ans == "S":

            skip = skip + 1

        else:

            score = score - 1
            wrong = wrong + 1

    percentage = (score / (len(questions) * 4)) * 100

    if percentage >= 80:

        grade = "EXCELLENT"

    elif percentage >= 65:

        grade = "GOOD"

    elif percentage >= 50:

        grade = "AVERAGE"

    else:

        grade = "BELOW AVERAGE"

    print("\n--- RESULT ---")

    print("Correct:", correct)
    print("Wrong:", wrong)
    print("Skipped:", skip)

    print("Score:", score)
    print("Percentage:", percentage)

    print("Grade:", grade)

    result = {

        "name": name,
        "roll": roll,
        "score": score,
        "percentage": percentage,
        "grade": grade

    }

    all_results.append(result)


